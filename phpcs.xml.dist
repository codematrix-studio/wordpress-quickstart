<?xml version="1.0"?>
<ruleset name="WordPress Quickstart">
    <description>Проверка PHP-кода темы и плагинов по WordPress Coding Standards.</description>

    <file>wp-content/themes/quickstart</file>
    <file>wp-content/plugins/quickstart-tools</file>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress"/>
</ruleset>
